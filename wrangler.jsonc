{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yt-niche-adviser",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
  // Workers AI powers avatar generation (@cf/black-forest-labs/flux-1-schnell).
  // It is a binding, not a key: the Worker authorizes itself, so this feature
  // adds no secret — nothing in .dev.vars, the CI env block, or wrangler secret.
  // Inference always runs remotely, including under `astro dev`.
  "ai": {
    "binding": "AI",
  },
  // Burst guard on /api/analyze. The budget being protected is the shared
  // YouTube Data API quota (10,000 units/day per Google Cloud project), so the
  // limiter is keyed on the authenticated user rather than on IP or path.
  //
  // `period` accepts only 10 or 60 — no other value validates. Enforcement is
  // per Cloudflare location, not global, so this is a burst guard rather than a
  // daily budget; local `wrangler dev` behaviour may not match production.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
    // Separate namespace for avatar generation. The budget here is the Workers
    // AI neuron allocation (10,000/day free, ~57.6 per 1024px image), which is a
    // different resource from the YouTube quota RATE_LIMITER guards — sharing
    // one namespace would let an Analyze burst lock out avatar generation and
    // vice versa. Also keyed on the user, since that is who spends the budget.
    {
      "name": "AVATAR_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
}
