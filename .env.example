# Copy to .env (Node dev / astro build) and to .dev.vars (Cloudflare workerd dev).
# Both are gitignored. Never commit real values.

# --- Supabase (required for auth) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=<supabase-anon-key>

# --- Supabase Auth: Google OAuth provider (F-01, local supabase only) ---
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=<google-oauth-client-id>
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=<google-oauth-client-secret>

# --- YouTube Data API v3 (S-02 Analyze) ---
# Enable "YouTube Data API v3" on the yt-niche-adviser Google Cloud project, then mint an API key.
YOUTUBE_API_KEY=<youtube-data-api-v3-key>

# --- Anthropic (S-02 opportunity justifications) ---
ANTHROPIC_API_KEY=<anthropic-api-key>
