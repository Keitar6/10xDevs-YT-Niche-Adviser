---
import Layout from "@/layouts/Layout.astro";
import DashboardPanels from "@/components/dashboard/DashboardPanels";
import { loadSavedOpportunities } from "@/lib/services/content-opportunity-server";

const { user } = Astro.locals;
const { opportunities: initialSaved, loadFailed } = user
  ? await loadSavedOpportunities(Astro.request.headers, Astro.cookies, user.id)
  : { opportunities: [], loadFailed: false };
---

<Layout title="Dashboard">
  <div class="mx-auto w-full max-w-3xl flex-1 py-4">
    <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Dashboard
      </h1>
      <p class="text-blue-100/80">
        Welcome, <span class="font-semibold text-white">{user?.email}</span>
      </p>
      <p class="mt-2 text-sm text-blue-100/50">This page is only for authenticated users.</p>
    </div>

    <DashboardPanels initialSaved={initialSaved} loadFailed={loadFailed} client:load />
  </div>
</Layout>
