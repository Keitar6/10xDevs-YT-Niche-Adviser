---
// Bindings come off the module-level `env`; `Astro.locals.runtime` was removed
// in @astrojs/cloudflare v13 / Astro 6 (see src/pages/api/analyze.ts:15).
import { env } from "cloudflare:workers";
import { createClient } from "@/lib/supabase";
import { parseChannelProfile } from "@/lib/services/channel-profile";
import { signAvatarUrl } from "@/lib/services/avatar-storage";
import ProfileDialog from "@/components/profile/ProfileDialog";

const { user } = Astro.locals;

const supabase = createClient(Astro.request.headers, Astro.cookies);
const { data: profileRow, error: profileError } =
  supabase && user
    ? await supabase.from("channel_profiles").select("*").eq("user_id", user.id).maybeSingle()
    : { data: null, error: null };

// `competitors` is generated as `Json`, so the row is validated before use.
const profile = parseChannelProfile(profileRow);

// The bucket is private, so the row stores an object path and the readable URL
// is minted here, per render. Its ~1h window is therefore spent on how long the
// tab stays open, not on how long the image is displayed.
//
// A failed signing is kept distinct from "no avatar": the write path replaces
// objects, so letting a misread look like an empty slot would invite a
// destructive overwrite (impl-review F4).
const avatarUrl = supabase && profile?.avatar_path ? await signAvatarUrl(supabase, profile.avatar_path) : null;
const avatarLoadFailed = !!profile?.avatar_path && avatarUrl === null;

// Deliberately not routed through src/lib/config-status.ts: that module reads
// secrets from astro:env/server at module scope, and this is neither a secret
// nor module-scoped. Checking per request means the Generate button is hidden
// rather than offered and then failing with a 503.
const canGenerate = !!(env as Record<string, unknown>).AI;
---

<div
  class="mb-4 flex items-center justify-between rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm text-white/80"
>
  {
    user ? (
      <>
        <span class="text-blue-100/70">{user.email}</span>
        <div class="flex items-center gap-3">
          <a href="/dashboard" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Dashboard
          </a>
          <ProfileDialog
            initialProfile={profile}
            loadFailed={!!profileError}
            initialAvatarUrl={avatarUrl}
            avatarLoadFailed={avatarLoadFailed}
            canGenerate={canGenerate}
            client:load
          />
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
              Sign out
            </button>
          </form>
        </div>
      </>
    ) : (
      <>
        <span class="text-blue-100/70">Not signed in</span>
        <div class="flex gap-3">
          <a href="/auth/signin" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Sign in
          </a>
          <a href="/auth/signup" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Sign up
          </a>
        </div>
      </>
    )
  }
</div>
