---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import { missingConfigs } from "@/lib/config-status";
import { Toaster } from "@/components/ui/sonner";
import Topbar from "@/components/Topbar.astro";

interface Props {
  title?: string;
  /** Set false for a page that wants the bare cosmic ground with no top bar. */
  topbar?: boolean;
}

const { title = "10x Astro Starter", topbar = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body>
    {
      missingConfigs.map((cfg) => (
        <Banner variant="error">
          <strong>Warning:</strong> {cfg.message}
          {cfg.docsUrl && (
            <>
              {" "}
              <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
                {cfg.docsLabel ?? "Documentation"}
              </a>
              .
            </>
          )}
        </Banner>
      ))
    }
    <div class="bg-cosmic relative flex min-h-screen flex-col p-4 sm:p-8">
      {topbar && <Topbar />}
      <slot />
    </div>
    {
      /* `client:only`: sonner is pre-bundled for SSR with its own React copy, so
        rendering `Toaster` on the server throws an invalid-hook-call. The toast
        container has no server output worth keeping, so skipping SSR costs nothing. */
    }
    <Toaster client:only="react" />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
